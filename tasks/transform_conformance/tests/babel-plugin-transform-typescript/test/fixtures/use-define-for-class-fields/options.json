{
  "assumptions": {
    "setPublicClassFields": true
  },
  "plugins": [
    [
      "proposal-decorators",
      {
        "version": "2023-11"
      }
    ],
    "transform-class-properties",
    [
      "transform-typescript",
      {
        "removeClassFieldsWithoutInitializer": true
      }
    ]
  ]
}
