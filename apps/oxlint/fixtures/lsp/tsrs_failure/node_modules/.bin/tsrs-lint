#!/bin/sh
# Fake `tsrs-lint` that fails. `headless` ignores its input and answers with one error frame
# (`u32 LE length | u8 type 0 | {"error":"fake failure"}`). It has no `server` mode, as an old
# `tsrs-lint`, so it exits before the server handshake.
if [ "$1" != "headless" ]; then
  exit 2
fi
cat >/dev/null
printf '\030\000\000\000\000{"error":"fake failure"}'
