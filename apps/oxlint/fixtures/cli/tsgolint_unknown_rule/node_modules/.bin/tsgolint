#!/bin/sh
# Fake type-aware linter that predates the `no-unsafe-class-instance-assignment` rule:
# it rejects that rule with an `unknown rule` error, like the `tsrs` releases that
# predate it, and reports an `await-thenable` diagnostic once the payload no longer
# contains the rejected rule.
payload=$(cat)

# Emits one message: a 4 byte little-endian payload size, a 1 byte message type,
# then the payload. $1 = message type, $2 = JSON payload.
emit() {
    size=$(printf '%s' "$2" | wc -c | tr -d ' ')
    printf "$(printf '\\%03o' $((size % 256)))"
    printf "$(printf '\\%03o' $((size / 256 % 256)))"
    printf "$(printf '\\%03o' $((size / 65536 % 256)))"
    printf "$(printf '\\%03o' $((size / 16777216 % 256)))"
    printf "$(printf '\\%03o' "$1")"
    printf '%s' "$2"
}

if printf '%s' "$payload" | grep -q 'no-unsafe-class-instance-assignment'; then
    emit 0 '{"error":"error running linter: unknown rule: no-unsafe-class-instance-assignment"}'
    exit 1
fi

file_path=$(printf '%s' "$payload" | sed 's/.*"file_paths":\["\([^"]*\)".*/\1/')
emit 1 "{\"kind\":0,\"range\":{\"pos\":0,\"end\":8},\"rule\":\"await-thenable\",\"message\":{\"id\":\"await\",\"description\":\"Unexpected \`await\` of a non-Promise (non-Thenable) value.\",\"help\":null},\"file_path\":\"$file_path\"}"
exit 0
