exports[`Format js-in-vue > should format .vue w/ sort-imports 1`] = `
"<script lang="ts">
  import a from "a";
  import m from "m";
  import z from "z";
</script>
<script lang="ts" setup>
  import a from "a";
  import m from "m";
  import z from "z";
</script>
<template><div>{{ a + m + z }}</div></template>
"
`;

exports[`Format js-in-vue > should format .vue w/ sort-tailwindcss 1`] = `
"<script setup>
  import clsx from "clsx";
  import { ref } from "vue";

  const count = ref(0);
  const cls = clsx("flex p-4");
</script>
<template>
  <div class="flex p-4">{{ count }}</div>
  <div class="flex p-4">{{ count }}</div>
</template>
"
`;

