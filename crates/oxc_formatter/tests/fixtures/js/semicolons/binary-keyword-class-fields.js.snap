==================== Input ====================
// DIVERGENCES.md#binary-keyword-class-field-boundary
class Fields {
  x = 1;
  in;
  y = value;
  instanceof;
}
class Methods {
  x = value;
  in() {}
  y = value;
  instanceof() {}
}
class QuotedKeys {
  x = value;
  "in";
  y = value;
  "instanceof"() {}
}
class ModifiedKeys {
  x = value;
  static in;
  y = value;
  async instanceof() {}
}

