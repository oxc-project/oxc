    light !== null
  )) {
    break;
  }

  do {
    light = lights.pop();
  } while (!(
    light instanceof DirectionalLight ||
    light instanceof SpotLight ||
    light !== null
  ));

  // `!!` hugs like `!`, `!!!` does not
  if (!!(
    light instanceof DirectionalLight ||
    light instanceof SpotLight ||
    light !== null
