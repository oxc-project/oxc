  /** @type {NonNullable<typeof v_reactions>} */ (v_reactions).has(r),
);
const needs_version_increase2 = !s.reactions?.every(
  (r) => /** @type {NonNullable<typeof v_reactions>} */ (v_reactions.has(r)),
);

