==================== Input ====================
{
  "block_comment_stays_inline": [1, 2 /* keep inline */],
  "line_comment_breaks": [1, 2 // trailing line comment
  ],
  "string_elements": ["a", "b" // last element
  ],
  "disables_concise": [1, 2, 3, 4 // disables concise
  ],
  "object_trailing": { "a": 1, "b": 2 // trailing
  }
}

