==================== Input ====================
{
  // Above the threshold: wraps two per line, trailing comma follows the option
  "wrapped": ["a", "b", "c", "d", "e"],
  // At or below the threshold: stays flat
  "flat": ["a", "b", "c"]
}

==================== Output ====================
--------------------------------------------------------------------------------------
{ arrayWrap: {"linePattern":"2","wrapThreshold":3}, printWidth: 80, variant: "jsonc" }
--------------------------------------------------------------------------------------
{
  // Above the threshold: wraps two per line, trailing comma follows the option
  "wrapped": [
    "a", "b",
    "c", "d",
    "e",
  ],
  // At or below the threshold: stays flat
  "flat": ["a", "b", "c"],
}

