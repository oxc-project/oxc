  ⚠ react(globals): Cannot reassign variables declared outside of the component/hook
   ╭─[globals.tsx:5:5]
 4 │   const setGlobal = () => {
 5 │     someGlobal = true;
   ·     ─────┬────
   ·          ╰── `someGlobal` cannot be reassigned
