#!/usr/bin/env node
// Fake `tsrs-lint server` for the client tests in `src/tsgolint/server.rs`.
//
// It reads its behavior from `behavior.json` in its working directory, and appends every event
// (its start, and each frame it receives) as a JSON line to `frames.jsonl` there.
//
// behavior.json:
// - `start`: "ok" (default) answers the handshake; "exit" exits at once without reading its input,
//   as a `tsrs-lint` without server mode does.
// - `protocol_version`: the protocol version it answers the handshake with (default 1).
// - `hello_delay_ms`: how long it waits before it answers the handshake (default 0). It logs
//   `{ "event": "hello" }` when it answers.
// - `lint`: "done" (default) answers a Lint with a diagnostic for another request id, a diagnostic
//   for this one and Done; "exit" exits; "hold" answers only after a Cancel for it, with a
//   canceled error; "slow" sends a diagnostic for another request id every 50 ms for `slow_ms`,
//   then answers as "done" does; "stuck" sends a diagnostic for another request id every 50 ms,
//   and never answers, even after a Cancel.

"use strict";

const fs = require("node:fs");
const path = require("node:path");

const cwd = process.cwd();
const behaviorPath = path.join(cwd, "behavior.json");
const behavior = fs.existsSync(behaviorPath)
  ? JSON.parse(fs.readFileSync(behaviorPath, "utf8"))
  : {};
const logPath = path.join(cwd, "frames.jsonl");

function log(entry) {
  fs.appendFileSync(logPath, `${JSON.stringify(entry)}\n`);
}

function write(type, message) {
  const json = Buffer.from(JSON.stringify(message), "utf8");
  const header = Buffer.alloc(5);
  header.writeUInt32LE(json.length, 0);
  header.writeUInt8(type, 4);
  process.stdout.write(Buffer.concat([header, json]));
}

function diagnostic(id, filePath) {
  return {
    id,
    kind: 0,
    range: { pos: 0, end: 1 },
    message: { id: "fake", description: `fake diagnostic for request ${id}`, help: null },
    file_path: filePath,
    rule: "no-floating-promises",
  };
}

log({ event: "start", pid: process.pid, argv: process.argv.slice(2) });

if (behavior.start === "exit") {
  process.exit(0);
}

const held = new Set();

function handle(type, message) {
  log({ type, message });
  switch (type) {
    // Hello
    case 22:
      setTimeout(() => {
        log({ event: "hello" });
        write(4, { protocol_version: behavior.protocol_version ?? 1, version: "0.0.0-fake" });
      }, behavior.hello_delay_ms ?? 0);
      break;
    // Lint
    case 20: {
      const mode = behavior.lint ?? "done";
      if (mode === "exit") {
        process.exit(1);
      } else if (mode === "hold") {
        held.add(message.id);
      } else if (mode === "stuck") {
        // Never answers, nor ends the request when it is canceled, while it sends frames for
        // another request every 50 ms.
        const filePath = message.configs[0]?.file_paths[0] ?? "unknown.ts";
        setInterval(() => write(1, diagnostic(message.id + 1000, filePath)), 50);
      } else if (mode === "slow") {
        // Busy for `slow_ms`, sending frames for another request every 50 ms, then answers.
        const filePath = message.configs[0]?.file_paths[0] ?? "unknown.ts";
        const busy = setInterval(() => write(1, diagnostic(message.id + 1000, filePath)), 50);
        setTimeout(() => {
          clearInterval(busy);
          write(1, diagnostic(message.id, filePath));
          write(3, { id: message.id });
        }, behavior.slow_ms ?? 0);
      } else {
        const filePath = message.configs[0]?.file_paths[0] ?? "unknown.ts";
        write(1, diagnostic(message.id + 1000, filePath));
        write(1, diagnostic(message.id, filePath));
        write(3, { id: message.id });
      }
      break;
    }
    // Cancel
    case 23:
      if (held.delete(message.id)) {
        write(0, { id: message.id, error: "request canceled", canceled: true });
      }
      break;
    // Shutdown
    case 21:
      log({ event: "exit" });
      process.exit(0);
      break;
    default:
      break;
  }
}

let buffer = Buffer.alloc(0);
process.stdin.on("data", (chunk) => {
  buffer = Buffer.concat([buffer, chunk]);
  while (buffer.length >= 5) {
    const length = buffer.readUInt32LE(0);
    if (buffer.length < 5 + length) {
      break;
    }
    const type = buffer.readUInt8(4);
    const message = JSON.parse(buffer.subarray(5, 5 + length).toString("utf8"));
    buffer = buffer.subarray(5 + length);
    handle(type, message);
  }
});
process.stdin.on("end", () => process.exit(0));
