==================== Input ====================
// Less-specific case handling (shared selector/value rules live in
// scss/case-normalize.scss): variable / mixin names, escaped strings, and
// guard operands keep their case; units and hex still normalize.
@Keep-Var-Case: RED;
@KeepUnit: 5PX;
.KeepMixinName(@Arg: INITIAL) {
  color: @Arg;
}
.user {
  .KeepMixinName(@Keep-Var-Case);
  background: ~"URL(KeepEscapedString)";
  width: @KeepUnit;
  border-color: #AAbbCC;
}
.guarded when (@Keep-Var-Case = RED) {
  prop: val;
}

