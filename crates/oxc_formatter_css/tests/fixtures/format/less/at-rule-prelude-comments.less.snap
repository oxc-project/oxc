// Comments inside an at-rule prelude are never lost (see the scss twin).
@import // c
  "a";
@import (reference) "a" // c
;
// A vendor-prefixed keyframes prelude keeps its comments in place like `@keyframes`
@-webkit-keyframes /* Safari */ hover /* and Chrome */ {
  from {
    a: b;
  }
}

