==================== Input ====================
// Backtick JavaScript evaluation prints verbatim (see DIVERGENCES.md "less-javascript-verbatim")
.a {
  js: `"hello world"`;
  ternary: `(1 + 1 == 2 ? true : false)`;
  multiline: `(function(){var x = 1 + 1;
           return x})()`;
  ary: `@{ary}.join(', ')`;
  escaped: ~`2 + 5 + 'px'`;
}

