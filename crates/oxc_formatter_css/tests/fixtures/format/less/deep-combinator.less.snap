==================== Input ====================
.parent /deep/ .child {
  color: red;
}
.a ^ .b,
.c ^^ .d {
  color: blue;
}
.container /shadow/ .content {
  background: blue;
}
// `/DEEP/` stays: vue-loader and Angular match `/deep/` case-sensitively
.x /DEEP/ .y {
  color: red;
}

