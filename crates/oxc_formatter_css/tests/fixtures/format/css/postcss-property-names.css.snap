==================== Input ====================
/* A Css property name is postcss's glued token run, not necessarily an ident
   (oxc-css-parser README "Acceptance"). Prettier prints it verbatim, lowercased. */
.hacks {
  *zoom: 1;
  _width: 200px;
  +color: red;
  *+Color: red;
  :x: y;
  .x: y;
  #x: y;
  *color : black;
}

/* oxc-project/oxc#26290: a digit-led name */
@text {
  xl: 1.25rem, 1.75rem;
  2XL: 1.5rem, 2rem;
}

/* Less merge markers are just part of the name in Css */
.merge {
  background+: url(1.png);
  background+_: url(2.png);
}

/* Tailwind v4 namespace resets, postcss-simple-vars interpolation */
@theme {
  --color-*: initial;
  --*: initial;
}
.vars {
  $(var)-size: 100%;
  margin-$(dir): 10px;
}

/* A leading $var token may be only the first part of the property name. */
.dollar-led {
  $foo+: red;
  $foo.bar: blue;
}

