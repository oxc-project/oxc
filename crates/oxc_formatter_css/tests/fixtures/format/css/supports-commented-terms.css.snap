==================== Input ====================
/* Comments between the terms: the terms print as they do without them */
@supports /* c */ (display:flex) and (gap:1PX) {
}
@supports /* c */ not ( display : flex ) {
}
@supports (a:b) /* c */ and (c:'d') {
}
@supports /* c */ ((display:flex) or (display:grid)) and selector(a:hover) {
}
@supports /* c */ (display: flex) and (gap: 1rem) and (grid-template-columns: repeat(auto-fill, minmax(100px, 1fr))) {
}
/* A paren in a comment, a comment opener in a string */
@supports /* (c) */ (display:flex) {
}
@supports /* c */ (content:'/*') {
}

/* A comment inside a term: the terms fill as Prettier's value parser lays them out, a term breaking open only when it does not fit */
@supports (/* c */ a:b) and (c:d) {
}
@supports (display /* c */ : flex) and (gap:1PX) {
}
@supports not (/* c */ display:flex) {
}
@supports (/* c */ display:flex) and (gap:1rem) and (grid-template-columns:repeat(auto-fill, minmax(100px, 1fr))) {
}
/* A function's `:` is its argument's own */
@supports (/* d */ a:b) and selector(/* e */ a:hover) {
}
/* Widths are display widths */
@supports (/* 全角のコメントは表示幅で測る */ display: flex) and (/* 日本語 */ gap: 1rem) {
}
/* A lone term is no fill item: no continuation indent */
@supports (/* a comment long enough to break this term */ grid-template-columns: repeat(auto-fill, minmax(100px, 1fr))) {
}
/* The same rebuild for a commented `@import` */
@import /* c */ url(a.css) screen and (min-width:100PX);

/* DIVERGENCES.md#prelude-keyword-case */
@supports /* c */ (DISPLAY:FLEX) {
}

