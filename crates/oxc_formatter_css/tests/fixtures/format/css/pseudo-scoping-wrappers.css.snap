:local(  .a   >   .b , .c ) {}
.drawer :deep(.sticky-tabs-header [role='tablist']) {}
:slotted(div[data-x='1']) {}
.very-long-selector-name-aaaaaaaaaaaaaa :deep(.another-long-selector-bbbbbbbbbbbbbbbbbbbbbb [role='tablist']) {}

