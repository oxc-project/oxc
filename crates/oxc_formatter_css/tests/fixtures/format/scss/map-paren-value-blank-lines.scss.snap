==================== Input ====================
// A blank line after a map item is preserved per the shared blank-line rule
// regardless of the value's shape.
// DIVERGES from Prettier (DIVERGENCES.md "map-paren-value-blank-lines"):
// it drops the blank when the item's value is paren-ish (a call / paren group),
// an artifact of its comma-group splitting (prettier/prettier#16824).
$colors: (
  a: rgba(#fff, 0.1),

  b: #111,
);

// Plain values keep the blank in both formatters (matching Prettier).
$plain: (
  a: #fff,

  b: #111,
);

