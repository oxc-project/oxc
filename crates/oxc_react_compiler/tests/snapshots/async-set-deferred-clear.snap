function Component() {
	let count = 0;
	const cb = () => count++;
	const callbacks = new Set([cb]);
	const run = async () => {
		await 0;
		callbacks.forEach(_temp);
	};
	run();
	callbacks.clear();
	return null;
}
function _temp(fn) {
	return fn();
}
