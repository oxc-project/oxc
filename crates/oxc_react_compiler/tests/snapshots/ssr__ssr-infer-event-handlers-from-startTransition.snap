// @outputMode:"ssr"
function Component() {
	const [, startTransition] = useTransition();
	const state = 0;
	const ref = useRef(null);
	const onChange = (e) => {
		startTransition(() => {
			setState.call(null, e.target.value);
		});
	};
	return <CustomInput value={state} onChange={onChange} ref={ref} />;
}
