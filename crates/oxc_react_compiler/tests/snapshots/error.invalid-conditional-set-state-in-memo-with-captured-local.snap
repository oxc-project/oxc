OxcDiagnostic { inner: OxcDiagnosticInner { message: "Calling setState from useMemo may trigger an infinite loop", labels: [LabeledSpan { label: Some("Found setState() within useMemo()"), span: Span { start: 189, end: 288 }, primary: true }], help: Some("Each time the memo callback is evaluated it will change state. This can cause a memoization dependency to change, running the memo function again and causing an infinite loop. Instead of setting state in useMemo(), prefer deriving the value during render"), note: Some("React Compiler skipped optimizing this component or hook"), severity: Error, code: OxcCode { scope: Some("react-compiler"), number: Some("RenderSetState") }, url: Some("https://react.dev/reference/eslint-plugin-react-hooks/lints/set-state-in-render") } }

// @validateNoSetStateInRender @outputMode:"lint"
import { useMemo, useState } from "react";
function Component({ flag }) {
	const [value, setValue] = useState(0);
	const read = useMemo(() => {
		let cached;
		if (flag) setValue(value + 1);
		return () => cached ??= value;
	}, [flag, value]);
	return <button onClick={read}>{value}</button>;
}
function ReturnedHandler({ flag }) {
	const [value, setValue] = useState(0);
	const onClick = useMemo(() => {
		let cached;
		return () => {
			if (flag) setValue(cached ??= value + 1);
		};
	}, [flag, value]);
	return <button onClick={onClick}>{value}</button>;
}
