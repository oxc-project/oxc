<template>
  {{ "<this_is_a_tag_like string>" }}
  <p>{{ '<b>bold</b>' }}</p>
  <p :title="`<x y>`">{{ `<a href="z">` }}</p>
  <p
    :title="String(Object.values<number>(foo))"
    v-if="Object.keys<string>(foo).length > 0"
    @click="fn<number>(1)"
  >
    {{ a < b ? x : y }}
  </p>
  <p
    :title="(obj as Record<string, string>).value"
    @click="go(obj as Map<string, number>)"
  >
