==================== Input ====================
<div a // c
></div>
<div a="1" // c
  b="2"></div>
<div a="1"
  // own line
  b="2"></div>
<div // after the name
  a></div>
<div a="1" // c1
  b="2" // c2
></div>
<div a="1" /* c */ b="2"></div>
<div a="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" /* c */ b="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"></div>
<div a="1"
  /* own line */
  b="2"></div>

